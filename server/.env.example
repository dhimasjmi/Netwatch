APP_NAME=NetWatch
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://netwatch.perusahaan.local
APP_LOCALE=id
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=netwatch
DB_USERNAME=netwatch
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

# Pengaturan NetWatch (nilai bawaan ada di config/netwatch.php)
NETWATCH_FORCE_HTTPS=true
# Isi bila di belakang reverse proxy (Nginx/Caddy): IP proxy, pisahkan dengan koma
NETWATCH_TRUSTED_PROXIES=
NETWATCH_TIMEZONE=Asia/Jakarta
NETWATCH_HEARTBEAT_INTERVAL=30
NETWATCH_OFFLINE_AFTER=120

# Notifikasi offline/online (opsional)
NETWATCH_ALERTS_ENABLED=false
NETWATCH_TELEGRAM_TOKEN=
NETWATCH_TELEGRAM_CHAT_ID=
NETWATCH_ALERT_MAIL_TO=
# Ping dari server untuk perangkat offline (membedakan "PC mati" dan "agent mati")
NETWATCH_PING_ENABLED=true

# Riwayat browsing klien (butuh agent 1.3.0). Aktifkan hanya bila sesuai ketentuan perusahaan.
NETWATCH_BROWSING_ENABLED=false
# domain = hanya nama situs, path = juga alamat halaman (kata pencarian/query tidak pernah disimpan)
NETWATCH_BROWSING_DETAIL=domain
NETWATCH_RETENTION_BROWSING=14
NETWATCH_RETENTION_BROWSING_DAILY=365
NETWATCH_BROWSING_MAX_PER_DEVICE_DAY=5000

# Windows Event Log klien (error/kritis log System & Application) masuk ke Event Viewer, hanya terlihat admin (butuh agent 1.4.0)
NETWATCH_WINLOG_ENABLED=false

# Network Operations Center: ping/cek port perangkat jaringan (switch, AP, printer, server) dari server, tiap menit
NETWATCH_MONITOR_ENABLED=true
NETWATCH_MONITOR_WARN_MS=150
NETWATCH_MONITOR_FAIL_THRESHOLD=2
# Bawaan hanya IP internal (privat). true bila perlu memantau IP publik.
NETWATCH_MONITOR_ALLOW_PUBLIC=false
NETWATCH_RETENTION_MONITOR=7

# Cache hasil halaman Monitoring (detik). 0 = tanpa cache.
NETWATCH_FLEET_CACHE=4
